# Database (optional — leave unset unless Postgres is running)
# DATABASE_URL="postgresql://evhunter:evhunter@localhost:5432/evhunter"

# Redis (optional — falls back to in-memory cache)
REDIS_URL="redis://localhost:6379"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-secure-random-string"

# OAuth (optional)
GITHUB_ID=""
GITHUB_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Kalshi public market data (no key required)
KALSHI_API_BASE_URL="https://api.elections.kalshi.com/trade-api/v2"

# Odds API (https://the-odds-api.com)
ODDS_API_KEY=""
ODDS_API_BASE_URL="https://api.the-odds-api.com/v4"

# Player/team stats: MLB Stats API + ESPN (no keys required)
# Optional override if you add a paid stats provider later
SPORTS_STATS_API_KEY=""
SPORTS_STATS_API_BASE_URL=""

# Development — false = live Kalshi MLB/NFL/NBA markets (no key required).
# Sportsbook odds still mock until ODDS_API_KEY is set.
USE_MOCK_DATA="false"

# Cron protection for /api/cron/odds and /api/cron/kalshi-settle
CRON_SECRET=""

# Alerts
DISCORD_WEBHOOK_URL=""
