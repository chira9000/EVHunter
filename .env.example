# Database
DATABASE_URL="postgresql://evhunter:evhunter@localhost:5432/evhunter"

# Redis (optional — falls back to in-memory cache)
REDIS_URL="redis://localhost:6379"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-secure-random-string"

# OAuth (optional)
GITHUB_ID=""
GITHUB_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Kalshi public market data (no key required)
KALSHI_API_BASE_URL="https://api.elections.kalshi.com/trade-api/v2"

# Odds API (https://the-odds-api.com)
ODDS_API_KEY=""
ODDS_API_BASE_URL="https://api.the-odds-api.com/v4"

# Sports stats API (placeholder)
SPORTS_STATS_API_KEY=""
SPORTS_STATS_API_BASE_URL=""

# Development
USE_MOCK_DATA="true"

# Cron protection for /api/cron/odds
CRON_SECRET=""

# Alerts
DISCORD_WEBHOOK_URL=""
